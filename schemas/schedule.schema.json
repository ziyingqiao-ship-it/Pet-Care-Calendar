{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ziyingqiao-ship-it.github.io/Pet-Care-Calendar/schemas/schedule.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "pet_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "care_type": {
      "enum": [
        "bath",
        "medication",
        "internal_deworming",
        "external_parasite_prevention",
        "vaccination"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "dosage_note": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "needs_information",
        "paused",
        "completed"
      ]
    },
    "schedule_rule": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "interval"
            },
            "value": {
              "type": "integer",
              "minimum": 1
            },
            "unit": {
              "enum": [
                "day",
                "week",
                "month",
                "year"
              ]
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "user",
                    "veterinarian",
                    "prescription",
                    "supplied_product_instructions",
                    "vaccination_record"
                  ]
                },
                "detail": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "detail"
              ]
            }
          },
          "required": [
            "type",
            "value",
            "unit",
            "source"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "fixed_date"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "user",
                    "veterinarian",
                    "prescription",
                    "supplied_product_instructions",
                    "vaccination_record"
                  ]
                },
                "detail": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "detail"
              ]
            }
          },
          "required": [
            "type",
            "date",
            "source"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "course"
            },
            "start_date": {
              "type": "string",
              "format": "date"
            },
            "end_date": {
              "type": "string",
              "format": "date"
            },
            "times": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "user",
                    "veterinarian",
                    "prescription",
                    "supplied_product_instructions",
                    "vaccination_record"
                  ]
                },
                "detail": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "detail"
              ]
            }
          },
          "required": [
            "type",
            "start_date",
            "end_date",
            "times",
            "source"
          ]
        }
      ]
    },
    "last_completed": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_due": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "completions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "occurrence_id": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "date"
        ]
      }
    },
    "reminder_minutes_before": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "pet_id",
    "care_type",
    "label",
    "timezone",
    "status",
    "schedule_rule",
    "last_completed",
    "next_due",
    "completions"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schedule_rule": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "needs_information",
              "paused",
              "completed"
            ]
          },
          "next_due": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "needs_information",
              "paused",
              "completed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "next_due": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        }
      },
      "then": {
        "properties": {
          "next_due": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "care_type": {
            "const": "medication"
          }
        }
      },
      "then": {
        "properties": {
          "schedule_rule": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "course"
                  },
                  "start_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "end_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "times": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "enum": [
                          "user",
                          "veterinarian",
                          "prescription",
                          "supplied_product_instructions",
                          "vaccination_record"
                        ]
                      },
                      "detail": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "detail"
                    ]
                  }
                },
                "required": [
                  "type",
                  "start_date",
                  "end_date",
                  "times",
                  "source"
                ]
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "schedule_rule": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "interval"
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "unit": {
                    "enum": [
                      "day",
                      "week",
                      "month",
                      "year"
                    ]
                  },
                  "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "enum": [
                          "user",
                          "veterinarian",
                          "prescription",
                          "supplied_product_instructions",
                          "vaccination_record"
                        ]
                      },
                      "detail": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "detail"
                    ]
                  }
                },
                "required": [
                  "type",
                  "value",
                  "unit",
                  "source"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "fixed_date"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "enum": [
                          "user",
                          "veterinarian",
                          "prescription",
                          "supplied_product_instructions",
                          "vaccination_record"
                        ]
                      },
                      "detail": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "detail"
                    ]
                  }
                },
                "required": [
                  "type",
                  "date",
                  "source"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          },
          "schedule_rule": {
            "type": "object",
            "properties": {
              "type": {
                "const": "interval"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "last_completed": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  ]
}
